# ═══════════════════════════════════════════════
#  ATS Intelligence v3.0 — Environment Variables
#  Copy this file to .env.local and fill in values
#  NEVER commit .env.local to git
# ═══════════════════════════════════════════════

# ── SUPABASE (Required for cloud data storage) ──
# Get these from: supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...YOUR_ANON_KEY

# ── GEMINI AI (Optional — users can also enter in Settings) ──
# Get from: aistudio.google.com → Get API Key
# If set here, it becomes the default key for all users
NEXT_PUBLIC_DEFAULT_AI_KEY=AIzaSy...YOUR_GEMINI_KEY
